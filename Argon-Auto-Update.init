#!/bin/sh /etc/rc.common

# Values and callbacks are consumed by /etc/rc.common.
# shellcheck disable=SC2034
USE_PROCD=1
# shellcheck disable=SC2034
START=99
# shellcheck disable=SC2034
STOP=10

INSTALLER=/root/FirmwareUpgradeOpenWRT/Install-LuCI-Argon-Theme.sh

start_service() {
  if [ ! -x "$INSTALLER" ]; then
    logger -t argon-auto-update "Installer not found or not executable: $INSTALLER"
    return 1
  fi

  procd_open_instance
  procd_set_param command "$INSTALLER" --non-interactive
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}

service_triggers() {
  procd_add_interface_trigger "interface.*" "wan" /etc/init.d/argon-auto-update restart
}
